{
  "openapi": "3.0.0",
  "info": {
    "title": "Odyssey Ops API",
    "version": "0.1.0",
    "description": "Restaurant operations API — menu, orders, customers, settings, metrics."
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/menu-categories": {
      "get": {
        "operationId": "listMenuCategories",
        "tags": [
          "Menu"
        ],
        "summary": "List menu categories",
        "responses": {
          "200": {
            "description": "Menu categories, ordered by sort order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "name": {
                        "type": "string"
                      },
                      "sortOrder": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 2147483647
                      },
                      "createdAt": {
                        "type": "string"
                      },
                      "updatedAt": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "sortOrder",
                      "createdAt",
                      "updatedAt"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createMenuCategory",
        "tags": [
          "Menu"
        ],
        "summary": "Create a menu category",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sortOrder": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "sortOrder": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "sortOrder",
                    "createdAt",
                    "updatedAt"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload"
          }
        }
      }
    }
  }
}
