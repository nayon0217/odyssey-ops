{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "gen:contract": "tsx scripts/emit-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "dotenv -e .dev.vars -- drizzle-kit push",
    "db:studio": "dotenv -e .dev.vars -- drizzle-kit studio",
    "db:seed": "dotenv -e .dev.vars -- tsx src/db/seed.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.3",
    "@odyssey/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "drizzle-zod": "^0.6.1",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.42.0"
  }
}
